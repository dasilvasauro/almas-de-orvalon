{
  "name": "almas-de-orvalon",
  "version": "1.4.0",
  "description": "Almas de Orvalon — jogo de cartas offline (Android via Capacitor, desktop via Electron)",
  "main": "electron/main.js",
  "private": true,
  "scripts": {
    "start": "npx --yes http-server www -p 8080 -c-1",
    "android:setup": "node scripts/android-setup.js",
    "android:sync": "npx cap sync android",
    "android:open": "npx cap open android",
    "android:apk": "cd android && ./gradlew assembleDebug",
    "android:icons": "npx capacitor-assets generate --android --iconBackgroundColor #100a15 --splashBackgroundColor #100a15",
    "desktop": "electron .",
    "linux:build": "electron-builder --linux AppImage deb",
    "build:web": "node scripts/build-single.js",
    "docs": "node scripts/gen-docs.js",
    "test:sim": "node scripts/sim-all.js 700",
    "pwa": "node scripts/gen-sw.js"
  },
  "dependencies": {
    "@capacitor/android": "7.0.1",
    "@capacitor/app": "7.0.0",
    "@capacitor/core": "7.0.1"
  },
  "devDependencies": {
    "@capacitor/assets": "3.0.5",
    "@capacitor/cli": "7.0.1",
    "electron": "33.2.1",
    "electron-builder": "25.1.8"
  },
  "build": {
    "appId": "com.orvalon.almas",
    "productName": "Almas de Orvalon",
    "directories": {
      "output": "dist"
    },
    "files": [
      "electron/**",
      "www/**",
      "resources/icon.png"
    ],
    "linux": {
      "target": [
        "AppImage",
        "deb"
      ],
      "category": "Game",
      "icon": "resources/icon.png",
      "maintainer": "Orvalon <orvalon@example.com>",
      "executableName": "almas-de-orvalon",
      "synopsis": "Jogo de cartas offline de fantasia sombria"
    },
    "afterPack": "scripts/after-pack.js"
  },
  "author": {
    "name": "Orvalon",
    "email": "orvalon@example.com"
  },
  "homepage": "https://example.com/orvalon"
}